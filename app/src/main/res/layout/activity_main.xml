<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- OpenGL texture view - full screen camera preview -->
    <com.flam.TextureView
        android:id="@+id/mainTextureView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/controlPanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Control panel at bottom -->
    <LinearLayout
        android:id="@+id/controlPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#E0E0E0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Status display -->
        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Initializing..."
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@android:color/holo_green_light"
            android:layout_marginBottom="8dp" />

        <!-- Performance metrics display -->
        <TextView
            android:id="@+id/fpsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="FPS: --"
            android:textSize="11sp"
            android:textColor="#333333"
            android:fontFamily="monospace"
            android:layout_marginBottom="12dp"
            android:lineSpacingMultiplier="1.2" />

        <!-- Processing toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Edge Detection"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/processingToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <!-- Save frame button -->
        <Button
            android:id="@+id/saveFrameButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💾 Save Frame to Downloads"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF"
            android:padding="12dp" />

        <!-- Export frame for web viewer button -->
        <Button
            android:id="@+id/exportFrameButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🌐 Export Frame for Web Viewer"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#2196F3"
            android:textColor="#FFFFFF"
            android:padding="12dp" />

        <!-- Low threshold control -->
        <TextView
            android:id="@+id/lowThresholdLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Low Threshold: 50"
            android:textSize="12sp"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <SeekBar
            android:id="@+id/lowThresholdSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="200"
            android:progress="50"
            android:visibility="gone" />

        <!-- High threshold control -->
        <TextView
            android:id="@+id/highThresholdLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="High Threshold: 150"
            android:textSize="12sp"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <SeekBar
            android:id="@+id/highThresholdSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="300"
            android:progress="150"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Performance overlay (top-right corner) -->
    <com.flam.PerformanceOverlay
        android:id="@+id/performanceOverlay"
        android:layout_width="200dp"
        android:layout_height="180dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="8dp"
        android:visibility="visible" />

    <!-- Info badge (top-left corner) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        android:background="#80000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_margin="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Flam"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="1280x720"
            android:textColor="#CCCCCC"
            android:textSize="10sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
